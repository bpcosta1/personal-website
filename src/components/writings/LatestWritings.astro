---
import { getCollection } from 'astro:content';

const allWritings = await getCollection('writings', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});

const latestWritings = allWritings
  .sort((a, b) => {
    const dateA = a.data.lastUpdated ?? a.data.date;
    const dateB = b.data.lastUpdated ?? b.data.date;
    return dateB.valueOf() - dateA.valueOf();
  })
  .slice(0, 5);
---

<div class="mt-8">
  <h2 class="text-2xl font-bold mb-6 text-white">Latest Writings</h2>
  <div class="space-y-4">
    {
      latestWritings.map((writing) => (
        <article class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 sm:gap-4 group">
          <a
            href={`/writings/${writing.id.replace(/\/index$/, '')}`}
            class="text-lg text-white group-hover:text-brand transition-colors"
          >
            {writing.data.title}
          </a>
          <div class="flex items-center gap-4 text-sm font-mono text-text-main/60 shrink-0">
            <span>{writing.data.readTime} min read</span>
          </div>
        </article>
      ))
    }
  </div>
  <div class="mt-6">
    <a href="/writings" class="text-brand hover:underline font-mono text-sm"
      >View all posts &rarr;</a
    >
  </div>
</div>
