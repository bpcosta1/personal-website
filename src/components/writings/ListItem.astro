---
import type { CollectionEntry } from 'astro:content';

interface Props {
  writing: CollectionEntry<'writings'>;
}

const { writing } = Astro.props;
---

<article
  class="border-l-2 border-brand/30 pl-4 py-1 hover:border-brand transition-colors"
>
  <a href={`/writings/${writing.id.replace(/\/index$/, '')}`} class="block group">
    <h2
      class="text-2xl font-bold text-white group-hover:text-brand transition-colors"
    >
      {writing.data.title}
    </h2>
    <div
      class="flex flex-col gap-0.5 text-sm font-mono text-text-main/60 mb-2 mt-1"
    >
      <div class="flex items-center gap-4">
        <span>{writing.data.readTime} min read</span>
        <time>
          {
            writing.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric',
            })
          }
        </time>
      </div>
      {
        writing.data.lastUpdated && (
          <span class="italic text-xs">
            Last updated: {
              writing.data.lastUpdated.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })
            }
          </span>
        )
      }
    </div>
    {
      writing.data.description && (
        <p class="text-text-main mb-3">{writing.data.description}</p>
      )
    }
    {
      writing.data.tags && writing.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-2">
          {writing.data.tags.map((tag) => (
            <span class="px-2 py-0.5 text-xs font-mono border border-text-main/30 text-text-main bg-transparent">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </a>
</article>
