---
import { Icon } from 'astro-icon/components';
import InteractiveHeader from './InteractiveHeader.svelte';
import Navigation from './Navigation.astro';
---

<InteractiveHeader
    client:load
    transition:name="header"
>
    <Navigation />
    <div class="flex gap-4 items-center text-text-main">
        <a
            href="https://github.com/bpcosta1"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-main hover:text-brand transition-all hover:-rotate-12 duration-200"
            aria-label="See my GitHub profile"
        >
            <Icon name="simple-icons:github" class="w-5 h-5" />
        </a>
        <a
            href="https://linkedin.com/in/bpcosta1"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-main hover:text-brand transition-all hover:rotate-12 duration-200"
            aria-label="See my LinkedIn profile"
        >
            <Icon name="simple-icons:linkedin" class="w-5 h-5" />
        </a>
        <a
            href="https://www.credly.com/users/bpcosta1"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-main hover:text-brand transition-all hover:-rotate-12 duration-200"
            aria-label="See my certifications on Credly"
        >
            <Icon name="simple-icons:credly" class="w-5 h-5" />
        </a>
    </div>
</InteractiveHeader>
