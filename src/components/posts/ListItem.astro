---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
---

<article
  class="border-l-2 border-brand/30 pl-4 py-1 hover:border-brand transition-colors"
>
  <a href={`/posts/${post.id}`} class="block group">
    <h2
      class="text-2xl font-bold text-white group-hover:text-brand transition-colors"
    >
      {post.data.title}
    </h2>
    <div
      class="flex items-center gap-4 text-sm font-mono text-text-main/60 mb-2 mt-1"
    >
      <span>{post.data.readTime} min read</span>
      <time>
        {
          post.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          })
        }
      </time>
    </div>
    {
      post.data.description && (
        <p class="text-text-main mb-3">{post.data.description}</p>
      )
    }
    {
      post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-2">
          {post.data.tags.map((tag) => (
            <span class="px-2 py-0.5 text-xs font-mono rounded-full border border-brand text-brand bg-transparent">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </a>
</article>
