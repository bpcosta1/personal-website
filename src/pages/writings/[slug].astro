---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const writings = await getCollection('writings');
  return writings.map((writing) => ({
    params: { slug: writing.id.replace(/\/index$/, '') },
    props: { writing },
  }));
}

const { writing } = Astro.props;
const { Content } = await render(writing);
---

<Layout title={`${writing.data.title} | Digital Garden`}>
  <article
    class="prose prose-invert prose-brand max-w-none prose-headings:font-serif prose-a:text-brand prose-p:leading-relaxed prose-pre:font-mono"
  >
    <header class="mb-10 not-prose">
      <a
        href="/writings/"
        class="inline-flex items-center gap-2 font-mono text-sm text-brand hover:underline mb-4"
      >
        <span aria-hidden="true">&larr;</span>
        Back to writings
      </a>
      <h1 class="text-3xl sm:text-4xl font-bold mb-3">{writing.data.title}</h1>
      <div
        class="flex flex-col gap-1 text-sm font-mono text-text-main/60 mb-4"
      >
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <span>{writing.data.readTime} min read</span>
          <time>
            {
              writing.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </time>
        </div>
        {
          writing.data.lastUpdated && (
            <div class="italic text-xs">
              Last updated: {
                writing.data.lastUpdated.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              }
            </div>
          )
        }
      </div>
      {
        writing.data.tags && writing.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {writing.data.tags.map((tag) => (
              <span class="px-3 py-1 text-xs font-mono border border-text-main/30 text-text-main bg-transparent">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <Content />
  </article>
</Layout>
