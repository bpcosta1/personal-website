---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | Digital Garden`}>
  <article
    class="prose prose-invert prose-brand max-w-none prose-headings:font-serif prose-a:text-brand prose-p:leading-relaxed prose-pre:font-mono"
  >
    <header class="mb-10 not-prose">
      <a
        href="/posts"
        class="inline-flex items-center gap-2 font-mono text-sm text-brand hover:underline mb-4"
      >
        <span aria-hidden="true">&larr;</span>
        Back to posts
      </a>
      <h1 class="text-4xl font-bold mb-3">{post.data.title}</h1>
      <div
        class="flex items-center gap-4 text-sm font-mono text-text-main/60 mb-4"
      >
        <span>{post.data.readTime} min read</span>
        <time>
          {
            post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
      </div>
      {
        post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="px-3 py-1 text-xs font-mono rounded-full border border-brand text-brand bg-transparent">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <Content />
  </article>
</Layout>
