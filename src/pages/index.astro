---
import Layout from '../layouts/Layout.astro';
import LatestPosts from '../components/posts/LatestPosts.astro';
---

<Layout title="Bruno Costa">
  <section class="space-y-6">
    <h1 class="text-3xl font-bold mb-4">
      Hey! I'm <span class="text-brand">{'{'}</span> Bruno Costa <span
        class="text-brand">{'}'}</span
      > 👋
    </h1>
    <p class="text-lg leading-relaxed text-justify">
      I'm a computer science student passionate about networking, cloud
      computing, and web development.
    </p>
    <p class="text-lg leading-relaxed text-justify">
      This is my little space on the internet, where I you can find <a
        href="./posts"
        class="hover:underline">my posts</a
      > about my projects and other things I find interesting. You can also check
      out the
      <a href="./uses" class="hover:underline">tools and apps</a> I use on a daily
      basis.
    </p>
    <p class="text-lg leading-relaxed text-justify">
      Feel free to reach out to me at <a href="mailto:me@bpcosta.com"
        >me@bpcosta.com</a
      >.
    </p>
  </section>

  <LatestPosts />
</Layout>
