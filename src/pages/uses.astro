---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Uses | Digital Garden">
  <section class="space-y-8">
    <h1 class="text-4xl font-bold mb-8">Uses</h1>
    
    <div class="space-y-4">
      <h2 class="text-2xl font-bold text-white">Hardware</h2>
      <ul class="list-disc list-inside space-y-2 text-text-main">
        <li>MacBook Pro 14" (M1 Pro)</li>
        <li>Keychron K3 Keyboard</li>
        <li>Logitech MX Master 3 Mouse</li>
      </ul>
    </div>
    
    <div class="space-y-4">
      <h2 class="text-2xl font-bold text-white">Software</h2>
      <ul class="list-disc list-inside space-y-2 text-text-main">
        <li>VS Code</li>
        <li>Arc Browser</li>
        <li>Notion</li>
      </ul>
    </div>
  </section>
</Layout>
